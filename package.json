{
  "name": "tauri-builder-kit",
  "version": "0.6.0",
  "description": "Tauri build CLI",
  "contributors": [
    "Tauri Programme within The Commons Conservancy"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "tauri-builder-kit": "dist/index.js"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "lint": "eslint .",
    "format": "prettier --write src/** README.md",
    "format:check": "prettier --check src/** README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tauri-apps/tauri-action.git"
  },
  "keywords": [
    "tauri",
    "cli"
  ],
  "minimumReleaseAge": 4320,
  "dependencies": {
    "@octokit/rest": "21.0.1",
    "execa": "9.6.1",
    "find-up-simple": "1.0.1",
    "globby": "16.0.0",
    "json5": "2.2.3",
    "smol-toml": "1.6.0",
    "string-argv": "0.3.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.4",
    "@vercel/ncc": "0.38.4",
    "covector": "0.12.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1"
  },
  "engines": {
    "pnpm": "^10.16.0",
    "node": ">=20"
  }
